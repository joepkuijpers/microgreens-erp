            try {
                // Probeer data op te halen uit de specifieke tabel voor deze module
                // LIMIT 5 om de pagina snel te houden
                $stmt = $db->query("SELECT * FROM <?php echo "sensor_logs"; ?> ORDER BY rowid DESC LIMIT 5");
                $gevonden = false;
                
                while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                    $gevonden = true;
                    // Toon de eerste 4 kolommen die gevonden worden
                    $keys = array_keys($row);
                    $col1 = isset($row[$keys[0]]) ? htmlspecialchars($row[$keys[0]]) : '-';
                    $col2 = isset($row[$keys[1]]) ? htmlspecialchars($row[$keys[1]]) : '-';
                    $col3 = isset($row[$keys[2]]) ? htmlspecialchars($row[$keys[2]]) : '-';
                    $col4 = isset($row[$keys[3]]) ? htmlspecialchars($row[$keys[3]]) : '-';

                    echo "<tr>
                            <td><strong>{$col1}</strong></td>
                            <td><span class='badge bg-running'>{$col2}</span></td>
                            <td>{$col3}</td>
                            <td>{$col4}</td>
                          </tr>";
                }

                if (!$gevonden) {
                    echo "<tr><td colspan='4' style='text-align:center; color:#7f8c8d; padding:20px;'>
