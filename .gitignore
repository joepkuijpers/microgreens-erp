# Database backups
database/backups/
*.backup
*.bak

# --- SENSOR & DATA BESTANDEN ---
sensors/*.db
sensors/logs/*.log

# --- HARDWARE RUNTIME (Alle state en logs) ---
hardware/**/*.log
hardware/**/*.json
!hardware/**/*.md

# --- PYTHON & SYSTEM ---
__pycache__/
*.py[cod]
*.pyo
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- TEST & TEMP FILES ---
test.php
test_*.php
*_test.php
temp_*.txt
temp_html.txt

