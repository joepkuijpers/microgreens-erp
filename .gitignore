database/MicrogreensERP_Live*.sqlite
database/MicrogreensERP_Development.sqlite
database/MicrogreensERP_Backup_*.sqlite

# Algemene regel: negeer ALLE .sqlite bestanden overal, BEHALVE de template
*.sqlite
