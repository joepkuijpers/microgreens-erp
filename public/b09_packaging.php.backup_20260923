<?php
session_start();
error_reporting(E_ALL);
ini_set('display_errors', 1);

$dbPath = '/var/www/html/microgreens/PHP/database/MicrogreensERP_Live.sqlite';

try {
    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    
    $cols = $db->query("PRAGMA table_info(finished_inventory)")->fetchAll(PDO::FETCH_COLUMN, 1);
    
    $idCol = 'id';
    $qtyCol = 'weight_grams'; // We weten nu dat het grams zijn
    if (!in_array($qtyCol, $cols)) {
        foreach(['weight', 'quantity', 'amount', 'qty'] as $c) { if(in_array($c, $cols)) { $qtyCol = $c; break; } }
    }
    if (!in_array($qtyCol, $cols) && count($cols) > 3) { $qtyCol = $cols[3]; }
    
    $refCol = 'harvest_id';
    if (!in_array($refCol, $cols)) {
        foreach(['batch_id', 'product_id'] as $c) { if(in_array($c, $cols)) { $refCol = $c; break; } }
    }
    if (!in_array($refCol, $cols) && count($cols) > 1) { $refCol = $cols[1]; }

} catch (PDOException $e) {
    die("DB Fout: " . $e->getMessage());
}

$msg = "";
$msgType = "";
$items = [];

try {
    $sql = "SELECT \"$idCol\" as id, \"$qtyCol\" as q, \"$refCol\" as ref FROM finished_inventory WHERE \"$qtyCol\" > 0";
    $items = $db->query($sql)->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    $msg = "Fout: " . $e->getMessage();
    $msgType = "error";
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $db->beginTransaction();
        $fid = intval($_POST['finished_inventory_id']);
        // Let op: input is in KG, maar DB is in GRAMS. We moeten converteren!
        $kgInput = floatval($_POST['weight']);
        $w = $kgInput * 1000; // Omrekenen naar grams voor de DB
        $p = floatval($_POST['sale_price_eur']);
        $pn = $_POST['product_name'] ?? 'Microgreens';
        
        $stmt = $db->prepare("SELECT \"$qtyCol\" as q, \"$refCol\" as r FROM finished_inventory WHERE \"$idCol\" = :id");
        $stmt->execute(['id' => $fid]);
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if (!$row) throw new Exception("Niet gevonden");
        if (floatval($row['q']) < $w) throw new Exception("Te weinig voorraad (Beschikbaar: " . round($row['q']/1000, 2) . " kg)");
        
        $ins = $db->prepare("INSERT INTO packaging_units (finished_inventory_id, batch_id, product_name, weight, sale_price_eur, status, packaged_date) VALUES (:f, :b, :p, :w, :s, 'PACKAGED', datetime('now'))");
        // We slaan het gewicht in KG op in packaging_units (standaard), maar trekken grams af van voorraad
        $ins->execute(['f' => $fid, 'b' => $row['r'], 'p' => $pn, 'w' => $kgInput, 's' => $p]);
        
        $upd = $db->prepare("UPDATE finished_inventory SET \"$qtyCol\" = \"$qtyCol\" - :w WHERE \"$idCol\" = :id");
        $upd->execute(['w' => $w, 'id' => $fid]);
        
        $db->commit();
        $msg = "✅ Succes verpakt!";
        $msgType = "success";
        
        $u = $_SESSION['user_id'] ?? 'guest';
        $d = microtime(true) - ($_SERVER['REQUEST_TIME_FLOAT'] ?? time());
        $l = $db->prepare("INSERT INTO user_activity_log (user_id, module, action, duration_seconds, timestamp) VALUES (:u,'B09','pack',:d,datetime('now'))");
        $l->execute(['u'=>$u,'d'=>round($d,3)]);
    } catch (Exception $e) {
        $db->rollBack();
        $msg = "❌ " . $e->getMessage();
        $msgType = "error";
    }
}
